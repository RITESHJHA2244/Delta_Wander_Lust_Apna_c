<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <form action="/listings" method="POST">
        <input name="title" placeholder="enter title" type="text">
        <br>
        <textarea name="description" placeholder="enter description" type="text"></textarea>
        <br>
        <input name="image" placeholder="enter image URL/Link" type="text">
        <br>
        <input name="price" placeholder="enter price" type="number">
        <br>
        <input name="location" placeholder="location" type="text">
        <br>
        <input name="Countyr" placeholder="enter country" type="text">
        <br>
        <button>Add</button>
    </form>
    
</body>
</html>